# Base URL of the Skladdo backend REST API (include the /api suffix).
# Local dev falls back to http://localhost:8080/api when this is unset.
# On Render, set this to your backend service URL, e.g. https://skladdo-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# "Sign in with Google": the OAuth 2.0 "Web application" client id from the Google Cloud console.
# Leave unset to hide the Google button entirely — email and password still work, so local development
# needs no Google project of its own.
#
# Baked into the bundle at build time, so it must be present when `npm run build` runs, not merely when
# the server starts. Must match the backend's APP_GOOGLE_CLIENT_ID, and the client's "Authorized
# JavaScript origins" must list this app's origin (http://localhost:5173 for local dev).
VITE_GOOGLE_CLIENT_ID=
